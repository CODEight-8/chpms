# =============================================================================
# CHPMS — Environment Configuration
# =============================================================================
# This file is a TEMPLATE. The setup wizard creates the real `.env` for you.
# If you ever need to edit it by hand, copy this file to `.env` and update
# each value below.
# =============================================================================

# --- Database password ---
# Used by the PostgreSQL container and by the application to connect to it.
# Pick a long, random password. The setup wizard generates one for you.
DB_PASSWORD=CHANGE_ME

# --- Database connection string ---
# Leave this exactly as-is unless you really know what you're doing.
DATABASE_URL="postgresql://chpms_user:CHANGE_ME@db:5432/chpms"

# --- NextAuth session secret ---
# Used to sign login session tokens. Pick a random 32-character string.
# Generate one with:   openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# --- Application URL ---
# The URL users will type into their browser to reach the system.
#   - For local-only use:    http://localhost:3000
#   - For Tailscale access:  http://chpms-host:3000   (use your Tailscale name)
NEXTAUTH_URL=http://localhost:3000

# --- First-time owner login ---
# These are the credentials for the very first administrator account.
# You will use them to log in the first time. You can change the password
# from inside the application later.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- System mode ---
# Always "live" for normal use. "snapshot" mode is reserved for future
# disaster-recovery features.
SYSTEM_MODE=live

# --- Backup retention ---
# How long the nightly database backups are kept. Tune to your storage budget.
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4

# --- Network binding (advanced) ---
# Default 0.0.0.0 binds the app to all interfaces so other machines on your
# Tailscale network or LAN can reach http://this-machine:3000. Set to
# 127.0.0.1 to restrict access to the host computer only.
APP_BIND_IP=0.0.0.0
